# ─────────────────────────────────────────────────────────────
# Configuración de la aplicación
# Copia este archivo a .env y ajusta los valores. NO uses credenciales reales
# en el repositorio.
# ─────────────────────────────────────────────────────────────

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP del servidor
PORT=4000

# Orígenes permitidos para CORS, separados por coma. Vacío = CORS deshabilitado.
# Ejemplo: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=

# ─────────────────────────────────────────────────────────────
# Conexión a PostgreSQL
# ─────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=credit_cards

# Pool de conexiones
PG_POOL_MAX=10
# Habilitar SSL en la conexión (true en entornos gestionados)
PG_SSL=false

# ─────────────────────────────────────────────────────────────
# Clave para la huella criptográfica (fingerprint) de tarjetas.
# Se usa con HMAC-SHA256 para detectar duplicados sin almacenar el PAN.
# DEBE ser un secreto robusto y distinto por entorno. NO reutilizar en prod.
# ─────────────────────────────────────────────────────────────
CARD_FINGERPRINT_SECRET=change-me-use-a-long-random-secret
